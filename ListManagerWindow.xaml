<Window x:Class="WinMix.ListManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="Manual"
        Title="Playlists" Height="300" Width="400">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView x:Name="PlayListView"
                  ItemsSource="{Binding PlaylistFiles}"
                  SelectedItem="{Binding SelectedPlaylist}"
                  SelectionMode="Single"
                  MinHeight="200"
                  Margin="0,0,0,8">
                    </ListView>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Delete..." Command="{Binding DeletePlaylistCommand}" Margin="4"/>
            <Button Content="Open" IsDefault="True" Command="{Binding OpenCommand}" Margin="4"/>
            <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" Margin="4"/>
        </StackPanel>
    </Grid>
</Window>
